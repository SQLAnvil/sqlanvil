#!/bin/bash
set -euo pipefail

# Type-aware lint rules need the npm types in node_modules and the generated sources in bazel-bin.
bazel run -- @pnpm//:pnpm --dir "$PWD" install --frozen-lockfile
bazel build //protos:ts //core:version

# Run eslint (tslint was retired with the rules_js toolchain; eslint.config.js carries the
# rules that mattered, including ordered-imports and the core/ sandbox guard).
bazel run //:eslint -- '**/*.ts'

# Check formatting of all .ts files with prettier (upstream #2458: CI runs this on every PR).
bazel run //:prettier -- --ignore-path .prettierignore --check '**/*.ts'
